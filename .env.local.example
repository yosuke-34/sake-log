# 酒ログ プロジェクト 環境変数テンプレート
#
# このファイルをコピーして `.env.local` を作成し、実際の値を入れてください。
# 実値はGitHubには絶対に上げないこと（.gitignore で .env* は除外済み）。
#
# 既存PCのバックアップは secrets/env.local.backup.txt にあります（あれば）。

# Supabase（必須）
# 取得元: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR...

# アフィリエイト（任意・未設定でも検索URLにフォールバック）
# 楽天アフィリエイトID（src/components/AffiliateLinks.tsx にもハードコードあり）
# NEXT_PUBLIC_RAKUTEN_AFFILIATE_ID=

# Amazonアソシエイトタグ（登録後に設定）
# NEXT_PUBLIC_AMAZON_ASSOCIATE_TAG=
